NEXT_PUBLIC_ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<your-organization-name>
NEXT_PUBLIC_ASGARDEO_CLIENT_ID=<your-app-client-id>
ASGARDEO_CLIENT_SECRET=<your-app-client-secret>

# Development only: print decoded ID token claims to the server terminal.
ASGARDEO_LOG_DECODED_ID_TOKEN=false

# These exact URLs must also be registered in the Asgardeo application.
NEXT_PUBLIC_ASGARDEO_AFTER_SIGN_IN_URL=http://localhost:3000
NEXT_PUBLIC_ASGARDEO_AFTER_SIGN_OUT_URL=http://localhost:3000
